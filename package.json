{
  "name": "swiftapp",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "check-dependencies": "rnx-align-deps",
    "fix-dependencies": "rnx-align-deps --write",
    "postinstall": "patch-package",
    "uncache": "ENVFILE=.env.dev react-native start --reset-cache",
    "uncache:node17:windows": "SET NODE_OPTIONS=--openssl-legacy-provider && npx react-native start --reset-cache",
    "uncache:node17:mac": "export NODE_OPTIONS=--openssl-legacy-provider && npx react-native start --reset-cache",
    "ios": "ENVFILE=.env.stg react-native run-ios",
    "ios15": "ENVFILE=.env.dev react-native run-ios --simulator='iPhone 15 Plus' --scheme Staging",
    "ios14": "ENVFILE=.env.prd react-native run-ios --simulator='iPhone 15'",
    "ios:dev16": "ENVFILE=.env.dev react-native run-ios --simulator='iPhone 16 Pro Max'",
    "ios:stg": "ENVFILE=.env.stg react-native run-ios --simulator='iPhone 16'",
    "android": "ENVFILE=.env.prd react-native run-android",
    "android:reset": "adb uninstall id.app.guardian && cd android && ./gradlew clean && cd .. && yarn android:stg",
    "android:reset:noapp": "cd android && ./gradlew clean && cd .. && yarn android:stg",
    "android:dev": "ENVFILE=.env.dev react-native run-android --mode=developmentDebug",
    "android:stg": "ENVFILE=.env.stg react-native run-android --mode=stagingDebug",
    "build": "cd android && ENVFILE=.env.prd ./gradlew assembleRelease",
    "build:dev": "cd android && ENVFILE=.env.dev ./gradlew assembleRelease",
    "build:stg:uncache": "cd android && ./gradlew clean && ENVFILE=.env.stg ./gradlew assembleStagingRelease",
    "build:prod:uncache": "cd android && ./gradlew clean && ENVFILE=.env.prd ./gradlew assembleProductionRelease",
    "build:stg": "cd android && ENVFILE=.env.stg ./gradlew assembleRelease",
    "build:bundle": "cd android && ENVFILE=.env.prd ./gradlew bundleRelease",
    "build:stg2": "set NODE_OPTIONS=--openssl-legacy-provider ENVFILE=.env.stg ./gradlew assembleRelease",
    "upload:android:stg": "./scripts/upload-firebase.sh staging",
    "upload:android:prod": "./scripts/upload-firebase.sh prod",
    "deploy:android:stg": "yarn install && yarn build:stg:uncache && yarn upload:android:stg",
    "deploy:android:prod": "yarn install && yarn build:prod:uncache && yarn upload:android:prod",
    "build:ios:stg": "IOS_CLEAN=2 ./scripts/build-ios-firebase.sh staging",
    "build:ios:prod": "IOS_CLEAN=2 ./scripts/build-ios-firebase.sh prod",
    "upload:ios:stg": "./scripts/upload-firebase-ios.sh staging",
    "upload:ios:prod": "./scripts/upload-firebase-ios.sh prod",
    "deploy:ios:stg": "yarn install && yarn build:ios:stg && yarn upload:ios:stg",
    "deploy:ios:prod": "yarn install && yarn build:ios:prod && yarn upload:ios:prod",
    "gqlgen": "graphql-codegen",
    "gqlgen:stg": "graphql-codegen --config ./codegen.stg.yml",
    "gqlgen:prd": "graphql-codegen --config ./codegen.prd.yml",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --fix",
    "pod": "cd ios && pod install",
    "pod:i": "cd ios && pod install",
    "pod:i:m1": "cd ios && arch -x86_64 pod install",
    "pod:i:m1:verbose": "cd ios && arch -x86_64 pod install --verbose",
    "pod:u": "cd ios && pod install --repo-update",
    "pod:u:m1": "cd ios && arch -x86_64 pod install --repo-update",
    "prepare": "husky install",
    "pod:c:m1": "rm -rf ios/Pods && rm -rf ios/Podfile.lock && yarn pod:i:m1",
    "pod:clean:cache:m1": "cd ios && arch -x86_64 pod deintegrate && arch -x86_64 pod cache clean --all",
    "clean": "rm -rf node_modules && yarn install && rm -rf ios/Pods && rm -rf ios/Podfile.lock && yarn pod:i",
    "clean:m1": "rm -rf node_modules && yarn install && rm -rf ios/Pods && rm -rf ios/Podfile.lock && yarn pod:i:m1",
    "clean:m1:pod": "rm -rf node_modules && yarn install && rm -rf ios/Pods && yarn pod:i:m1",
    "clean:m1:verbose": "rm -rf node_modules && yarn install && rm -rf ios/Pods && rm -rf ios/Podfile.lock && yarn pod:i:m1:verbose",
    "clean:lock": "rm -rf node_modules && rm -rf yarn.lock && yarn install && rm -rf ios/Pods && rm -rf ios/Podfile.lock && yarn pod:i",
    "clean:lock:m1": "rm -rf node_modules && rm -rf yarn.lock && yarn install && rm -rf ios/Pods && rm -rf ios/Podfile.lock && yarn pod:i:m1",
    "clean:lock:m1:verbose": "rm -rf node_modules && rm -rf yarn.lock && yarn install && rm -rf ios/Pods && rm -rf ios/Podfile.lock && yarn pod:i:m1:verbose",
    "bundle:js:ios": "react-native bundle --entry-file='index.js' --bundle-output='./ios/main.jsbundle' --dev=false --platform='ios' --assets-dest ios/assets --reset-cache",
    "bundle:js:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "clean-pod:m1:verbose": "rm -rf ios/Pods && yarn pod:i:m1:verbose",
    "clean-pod:lock:m1:verbose": "rm -rf ios/Pods && rm -rf ios/Podfile.lock && yarn pod:i:m1:verbose"
  },
