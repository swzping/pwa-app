ENV['RCT_NEW_ARCH_ENABLED'] = '0'

def node_require(script)
  # Resolve react_native_pods.rb with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
  "require.resolve(
    '#{script}',
    {paths: [process.argv[1]]},
  )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')

platform :ios, '15.1'
prepare_react_native_project!

target 'GuardianID' do
    config = use_native_modules!
    use_frameworks! :linkage => :static
    $RNFirebaseAsStaticFramework = true

    use_react_native!(
        :path => config[:reactNativePath],
        :app_path => "#{Pod::Config.instance.installation_root}/.."
    )

    # Only essential manual pods
    pod 'GoogleMaps', '9.4.0'
    pod 'Google-Maps-iOS-Utils'
    pod 'TikTokBusinessSDK'

    post_install do |installer|
        react_native_post_install(
            installer,
            config[:reactNativePath],
            :mac_catalyst_enabled => false
        )
        
        installer.pods_project.targets.each do |target|
            target.build_configurations.each do |config|
                config.build_settings['ENABLE_BITCODE'] = 'NO'
                config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
                config.build_settings['CODE_SIGNING_REQUIRED'] = "NO"
                config.build_settings['CODE_SIGNING_ALLOWED'] = "NO"
                config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
                # # 针对有问题的 SDK 进行特殊处理
                # if target.name == 'RNCDPAnalyticsModule'
                #     puts "Configuring architectures for #{target.name}..."
                #     target.build_configurations.each do |config|
                #         # 关键设置：确保框架在模拟器构建时，能正确找到并链接模拟器架构
                #         # 这告诉链接器，在链接胖二进制库时，要优先寻找模拟器切片
                #         config.build_settings['ARCHS[sdk=iphonesimulator*]'] = '$(ARCHS_STANDARD)'
                        
                #         # 对于某些复杂情况，可以同时设置 VALID_ARCHS
                #         config.build_settings['VALID_ARCHS[sdk=iphonesimulator*]'] = 'x86_64 arm64'
                        
                #         # 如果您明确想排除 arm64 真机切片（适用于某些旧脚本问题），但需谨慎：
                #         # config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
                #         # 注意：如果使用此行，可能会在 Apple Silicon Mac 的模拟器上链接失败，因为其模拟器也需要 arm64 切片。
                #         # 根据 lipo 结果，您有 arm64 切片，所以更好的方案是让链接器正确选择，而不是排除。
                #     end
                # end
            end
        end

        installer.aggregate_targets.each do |aggregate_target|
            aggregate_target.user_project.native_targets.each do |native_target|
            native_target.build_configurations.each do |config|
                config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
                end
            end
            aggregate_target.user_project.save
        end
    end

    target 'GuardianIDTests' do
        inherit! :complete
    end
end
